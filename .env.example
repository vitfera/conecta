# Origem HTTPS para canonical, sitemap e URL institucional, sem subpasta.
# O Docker de homologação adiciona noindex também no cabeçalho HTTP.
SITE_URL=https://conecta.victor.ferreira.nom.br

# ID de medição do Google Analytics 4, opcional no build do domínio de produção.
PUBLIC_GA_MEASUREMENT_ID=

# Porta HTTP publicada pelo Docker Compose. A porta interna permanece 8080.
APP_PORT=3019
