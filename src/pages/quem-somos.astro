---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import ProfilePortrait from '../components/ProfilePortrait.astro';
const professionalExperience = [
  {
    title: 'Rede Mapas — MinC / UFPR',
    description:
      'Experiência do responsável técnico em análise de projetos de software, levantamento de requisitos e evolução de soluções digitais do ecossistema Mapas Culturais, no âmbito de projeto desenvolvido pela UFPR em parceria com o Ministério da Cultura.',
  },
  {
    title: 'Rede das Artes — Funarte / UFC',
    description:
      'Experiência profissional em análise de negócios e sistemas para soluções digitais relacionadas à Rede das Artes, no âmbito do projeto Funarte/UFC.',
  },
  {
    title: 'Mapa Goiano — Secult Goiás',
    description:
      'Trajetória profissional em tecnologia aplicada à política cultural estadual, incluindo operação, aprimoramento e apoio à gestão do Mapa Goiano e de instrumentos de fomento.',
  },
  {
    title: 'Cult Editais / PNAB — Ministério da Cultura',
    description:
      'Consultoria e apoio técnico a plataformas de editais e à formação de gestores, conforme o histórico profissional do responsável técnico.',
  },
  {
    title: 'Periferia Viva — Ministério das Cidades',
    description:
      'Experiência profissional em requisitos, produto, organização de fluxos digitais e apoio a iniciativas voltadas aos territórios periféricos, incluindo o Prêmio Periferia Viva. Essa participação integra a trajetória do responsável técnico, sem representar contrato direto da Conecta.',
  },
  {
    title: 'Mapas Culturais — Acre',
    description:
      'Participação técnica na instalação da plataforma Mapas Culturais e na capacitação de gestores, conforme declaração da Fundação de Cultura Elias Mansour.',
  },
  {
    title: 'Caldas Country Show / Studio Tur',
    description:
      'Experiência do responsável técnico com sistemas de bilhetagem, integração de pagamentos, controle de acesso, suporte tecnológico, infraestrutura e dados de eventos.',
  },
  {
    title: 'Sistemas culturais — Pirenópolis',
    description:
      'Atuação profissional atestada em coordenação de sistemas relacionados a editais culturais e à execução da Lei Aldir Blanc no município.',
  },
];
---

<BaseLayout
  title="Quem somos"
  description="Conheça a Conecta Soluções e sua atuação na integração entre gestão, tecnologia, cultura e turismo, com atendimento em todo o Brasil."
>
  <PageHeading
    eyebrow="QUEM SOMOS"
    title="Conectar conhecimentos. Construir caminhos."
    description="Somos uma empresa de soluções integradas que aproxima a tecnologia da realidade de pessoas, projetos e instituições."
  />
  <section class="section">
    <div class="container about-intro">
      <div class="about-statement">
        <span class="orange-dash"></span>
        <p>
          Gestão e tecnologia.
          <br />
          Cultura e turismo.
          <br />
          <strong>Conhecimentos que se conectam.</strong>
        </p>
        <span>CONEXÕES COM PROPÓSITO</span>
      </div>
      <div class="about-copy">
        <p class="eyebrow">A CONECTA SOLUÇÕES</p>
        <h2>
          Uma visão integrada
          <br />
          do seu desafio.
        </h2>
        <p>
          A Conecta Soluções integra gestão e tecnologia para apoiar organizações e projetos,
          incluindo os setores de cultura e turismo. Desenvolvemos soluções para desafios
          administrativos, digitais e operacionais.
        </p>
        <p>
          Nossa abordagem parte do entendimento da realidade de cada projeto e combina análise de
          processos, implantação de sistemas, organização de dados, orientação técnica e
          acompanhamento de resultados.
        </p>
        <p>
          Em cultura e turismo, essa abordagem conecta a organização de informações, os serviços
          digitais e a comunicação de projetos. Consideramos os pontos de encontro entre as áreas e
          as necessidades de cada território.
        </p>
        <p>
          Com sede em Aparecida de Goiânia, Goiás, atendemos organizações e projetos em todo o
          Brasil, presencialmente ou a distância, conforme as necessidades de cada trabalho.
        </p>
      </div>
    </div>
  </section>
  <section class="section soft-section" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="orange-dash"></span>NOSSA FORMA DE ATUAR
          </p>
          <h2 id="principles-title">
            O contexto orienta.
            <br />A colaboração constrói.
          </h2>
        </div>
      </div>
      <div class="principle-grid">
        <div>
          <Icon name="process" size={30} />
          <h3>Entendimento antes da solução</h3>
          <p>
            Conhecemos os processos, as pessoas e as condições de operação antes de definir o
            caminho técnico.
          </p>
        </div>
        <div>
          <Icon name="code" size={30} />
          <h3>Técnica conectada à gestão</h3>
          <p>
            Reunimos desenvolvimento, organização de informações e acompanhamento para apoiar a
            execução.
          </p>
        </div>
        <div>
          <Icon name="support" size={30} />
          <h3>Conhecimento compartilhado</h3>
          <p>
            Formação e orientação ajudam equipes e gestores a utilizar e sustentar as soluções
            implantadas.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="section" id="equipe" aria-labelledby="victor-title">
    <div class="container profile-grid">
      <div class="profile-media">
        <ProfilePortrait />
      </div>
      <div class="profile-copy">
        <p class="eyebrow">
          <span class="orange-dash"></span>RESPONSÁVEL TÉCNICO
        </p>
        <h2 id="victor-title">
          Victor Ferreira
          <br />
          de Souza
        </h2>
        <p class="profile-role">Gestão, sistemas e projetos</p>
        <p>
          A empresa é liderada por Victor Ferreira de Souza, profissional com trajetória em sistemas
          e projetos de gestão pública, turismo, cultura, comunicação e eventos.
        </p>
        <p>
          Sua experiência inclui atuações em iniciativas vinculadas ao Ministério da Cultura, à
          Funarte, à Secretaria de Estado da Cultura de Goiás e ao Ministério das Cidades, além de
          projetos municipais e de tecnologia aplicada a eventos.
        </p>
        <div class="team-presentation">
          <h3>Uma equipe conectada ao seu projeto</h3>
          <p>
            A Conecta conta com uma equipe que trabalha em conjunto na construção e no
            acompanhamento das soluções. Sob a liderança de Victor, a atuação reúne colaboração,
            troca de conhecimento e organização das atividades em cada etapa do projeto.
          </p>
        </div>
        <div class="editorial-note">
          <strong>Trajetória profissional</strong>
          <p>
            Essas experiências dizem respeito ao responsável técnico, com os vínculos de cada
            atuação. Não representam, automaticamente, contratos diretos ou endosso institucional à
            Conecta Soluções.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="section soft-section" id="trajetoria" aria-labelledby="trajectory-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="orange-dash"></span>EXPERIÊNCIA DO RESPONSÁVEL TÉCNICO
          </p>
          <h2 id="trajectory-title">Conhecimentos construídos em diferentes contextos.</h2>
        </div>
        <p>
          Atuações profissionais de Victor Ferreira. Não representam contratos diretos, clientes ou
          endosso institucional à Conecta Soluções.
        </p>
      </div>
      <div class="principle-grid" data-professional-experience>
        {professionalExperience.map((experience) => (
          <div>
            <h3>{experience.title}</h3>
            <p>{experience.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
