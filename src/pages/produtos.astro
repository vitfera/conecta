---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import { getPublished } from '../lib/content';
const products = await Promise.all((await getPublished('products')).map(async product => ({ product, ...(await render(product)) })));
---
<BaseLayout title="Produtos e plataformas" description="Conheça os serviços especializados da Conecta sobre plataformas digitais, com identificação de disponibilidade e propriedade do software.">
  <PageHeading eyebrow="PRODUTOS E PLATAFORMAS" title="A tecnologia certa para cada contexto." description="Trabalhamos com desenvolvimento sob medida e serviços sobre plataformas existentes, sempre respeitando a autoria e os direitos de cada solução." />
  <section class="section"><div class="container">{products.map(({ product, Content }) => <article class="platform-card"><div class="platform-heading"><span class="icon-box"><Icon name="culture" size={32} /></span><span class="status-tag">{product.data.status === 'servicos-disponiveis' ? 'Serviços disponíveis' : 'Em desenvolvimento'}</span></div><h2>{product.data.title}</h2><div class="prose"><Content /></div><p class="ownership-note">{product.data.ownership}</p><a class="text-link" href="/solucoes/editais-e-mapas-culturais/">Conheça os serviços para gestão cultural <Icon size={18} /></a></article>)}</div></section><ContactCTA />
</BaseLayout>
