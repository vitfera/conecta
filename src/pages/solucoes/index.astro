---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Icon from '../../components/Icon.astro';
import { getPublished } from '../../lib/content';
import { getPublishedProducts } from '../../lib/content';
import FeaturedProduct from '../../components/FeaturedProduct.astro';
const services = (await getPublished('services')).sort((a, b) => a.data.order - b.data.order);
const featured = (await getPublishedProducts()).find(({ data }) => data.featured);
---

<BaseLayout
  title="Soluções"
  description="Software, gestão pública, dados, comunicação e formação, com aplicações em cultura e turismo. Conheça as seis frentes de atuação da Conecta Soluções."
>
  <PageHeading
    eyebrow="NOSSAS SOLUÇÕES"
    title="O seu desafio é o ponto de partida."
    description="Seis frentes de atuação que se complementam, da gestão pública aos projetos de cultura e turismo. Combinamos conhecimento técnico e visão de gestão para desenhar o caminho de cada projeto."
  />
  {featured && (
    <section class="section flagship-section" aria-label="Mapas Culturais em destaque">
      <div class="container">
        <FeaturedProduct product={featured} />
      </div>
    </section>
  )}
  <section class="section">
    <div class="container">
      <div class="service-grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
      <div class="inline-callout">
        <div>
          <p class="eyebrow">PRODUTOS E PLATAFORMAS</p>
          <h2>Tecnologia adequada ao contexto.</h2>
          <p>
            Conheça as plataformas com as quais trabalhamos e como podemos apoiar sua implantação.
          </p>
        </div>
        <a class="text-link" href="/produtos/">
          Explore as plataformas <Icon size={19} />
        </a>
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
