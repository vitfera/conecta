---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ConnectionVisual from '../components/ConnectionVisual.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ProjectStoryCard from '../components/ProjectStoryCard.astro';
import FeaturedProduct from '../components/FeaturedProduct.astro';
import ProductCard from '../components/ProductCard.astro';
import { getPublished, getPublishedProducts, getPublishedProjects } from '../lib/content';
const services = (await getPublished('services')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getPublishedProjects())
  .filter(({ data }) => data.relationship === 'contrato-direto')
  .slice(0, 2);
const products = (await getPublishedProducts()).filter(({ data }) => data.kind !== 'service');
const featured = products.find(({ data }) => data.featured);
const otherProducts = products.filter((product) => product.id !== featured?.id).slice(0, 4);
const steps = [
  {
    title: 'Escutar e entender',
    description: 'Conhecemos o contexto, as pessoas e o desafio que precisa ser resolvido.',
  },
  {
    title: 'Planejar o caminho',
    description: 'Definimos o escopo, as prioridades e a solução adequada ao projeto.',
  },
  {
    title: 'Construir e implantar',
    description: 'Transformamos o planejamento em processos, ferramentas e entregas.',
  },
  {
    title: 'Acompanhar e evoluir',
    description: 'Apoiamos a equipe na operação e na melhoria contínua da solução.',
  },
];
---

<BaseLayout title="Mapas Culturais e soluções digitais">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="orange-dash"></span>
          {featured?.id === 'mapas-culturais'
            ? 'MAPAS CULTURAIS · EDITAIS · TECNOLOGIA'
            : 'GESTÃO · TECNOLOGIA · CULTURA · TURISMO'}
        </p>
        <h1>
          Conectamos ideias, tecnologia e gestão para <span>transformar projetos em soluções.</span>
        </h1>
        <p class="hero-description">
          {featured?.id === 'mapas-culturais' ? (
            <>
              Implantamos <strong>Mapas Culturais</strong> e apoiamos a gestão de editais. Também
              desenvolvemos soluções digitais para organizações, cultura, turismo e gestão pública
              em todo o Brasil.
            </>
          ) : (
            <>
              Desenvolvemos soluções digitais e oferecemos consultoria para organizações, cultura,
              turismo e gestão pública em todo o Brasil.
            </>
          )}
        </p>
        <div class="hero-actions">
          <WhatsAppButton />
          <a class="text-link" href={featured ? `/produtos/${featured.id}/` : '/produtos/'}>
            {featured ? `Conheça o ${featured.data.title}` : 'Conheça os produtos'}{' '}
            <Icon size={18} />
          </a>
        </div>
        <p class="hero-location">
          <Icon name="location" size={15} />
          De Goiás, com atuação em todo o Brasil.
        </p>
      </div>
      <ConnectionVisual />
    </div>
  </section>
  <div class="context-strip">
    <div class="container context-inner">
      <p>
        Conhecimento técnico. Visão de gestão.
        <br />
        <strong>Soluções para diferentes contextos.</strong>
      </p>
      <div class="context-sectors">
        <span>Gestão pública</span>
        <span>Cultura</span>
        <span>Turismo</span>
        <span>Organizações e instituições</span>
      </div>
    </div>
  </div>
  {featured && (
    <section class="section flagship-section" aria-label="Mapas Culturais em destaque">
      <div class="container">
        <FeaturedProduct product={featured} />
      </div>
    </section>
  )}
  <section class="section solutions-section" aria-labelledby="solutions-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="orange-dash"></span>O QUE FAZEMOS
          </p>
          <h2 id="solutions-title">
            Diferentes desafios.
            <br />
            Uma atuação integrada.
          </h2>
        </div>
        <p>
          Conectamos tecnologia, processos e conhecimento para apoiar seu projeto, do planejamento à
          operação.
        </p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>
  <section class="section approach-section" aria-labelledby="approach-title">
    <div class="container approach-grid">
      <div>
        <p class="eyebrow">
          <span class="orange-dash"></span>A CONEXÃO FAZ A DIFERENÇA
        </p>
        <h2 id="approach-title">
          Tecnologia com
          <br />
          <span>contexto e propósito.</span>
        </h2>
        <p>
          Uma boa solução precisa fazer sentido para quem a utiliza. Por isso, aproximamos o
          conhecimento técnico da realidade de cada instituição.
        </p>
        <a class="text-link" href="/quem-somos/">
          Conheça a Conecta <Icon size={19} />
        </a>
      </div>
      <div class="approach-points">
        <div class="approach-point">
          <Icon name="check" />
          <div>
            <h3>Entendimento do seu contexto</h3>
            <p>
              Leitura dos processos, das políticas públicas e das necessidades de quem atua na
              gestão, na cultura e no turismo.
            </p>
          </div>
        </div>
        <div class="approach-point">
          <Icon name="check" />
          <div>
            <h3>Da estratégia à implementação</h3>
            <p>Consultoria e capacidade técnica reunidas para acompanhar o projeto na prática.</p>
          </div>
        </div>
        <div class="approach-point">
          <Icon name="check" />
          <div>
            <h3>Conhecimento compartilhado</h3>
            <p>Orientação, formação e suporte para que as equipes se apropriem das soluções.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="orange-dash"></span>COMO TRABALHAMOS
          </p>
          <h2 id="process-title">
            Cada projeto tem um contexto.
            <br />O nosso trabalho começa por ele.
          </h2>
        </div>
      </div>
      <div class="steps">
        {steps.map((step, index) => (
          <div class="step">
            <span class="step-number">0{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  {otherProducts.length > 0 && (
    <section class="section home-products" aria-labelledby="products-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              <span class="orange-dash"></span>OUTROS PRODUTOS
            </p>
            <h2 id="products-title">Mais soluções para conectar ideias à prática.</h2>
          </div>
          <a class="text-link" href="/produtos/">
            Explore os produtos
            <Icon size={18} />
          </a>
        </div>
        <div class="product-grid">
          {otherProducts.map((product) => (
            <ProductCard product={product} headingLevel="h3" />
          ))}
        </div>
      </div>
    </section>
  )}
  {projects.length > 0 && (
    <section class="section home-projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              <span class="orange-dash"></span>PROJETOS
            </p>
            <h2 id="projects-title">Histórias de projetos, conexões na prática.</h2>
          </div>
          <a class="text-link" href="/projetos/">
            Explore projetos <Icon size={18} />
          </a>
        </div>
        <div class="home-project-story-grid">
          {projects.map((project) => (
            <ProjectStoryCard project={project} compact headingLevel="h3" />
          ))}
        </div>
      </div>
    </section>
  )}
  <ContactCTA />
</BaseLayout>
