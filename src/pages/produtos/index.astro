---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import FeaturedProduct from '../../components/FeaturedProduct.astro';
import ProductCard from '../../components/ProductCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getPublishedProducts } from '../../lib/content';
const products = await getPublishedProducts();
const featured = products.filter(({ data }) => data.featured);
const others = products.filter(({ data }) => !data.featured);
---

<BaseLayout
  title="Produtos"
  description="Serviços para plataformas culturais e editais, além de sistemas para gestão imobiliária, pesquisas, viagens e ingressos digitais."
  noindex={products.length === 0}
>
  <PageHeading
    eyebrow="PRODUTOS"
    title="Tecnologia para diferentes desafios."
    description="Conheça os serviços para gestão cultural e os sistemas que conectam informação, atendimento e operação em diferentes setores."
  />
  <section class="section">
    <div class="container">
      {featured.map((product) => (
        <FeaturedProduct product={product} />
      ))}
      {others.length > 0 && (
        <div class:list={['other-products', { 'has-featured': featured.length > 0 }]}>
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                <span class="orange-dash"></span>OUTROS PRODUTOS
              </p>
              <h2>Soluções para o seu contexto.</h2>
            </div>
            <p>Conheça o que cada sistema reúne e converse com a Conecta sobre sua aplicação.</p>
          </div>
          <div class="product-grid">
            {others.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        </div>
      )}
      {products.length === 0 && (
        <EmptyState
          icon="code"
          title="Estamos preparando esta seleção."
          description="Em breve, apresentaremos os produtos e serviços disponíveis. Converse com a equipe para entender as possibilidades para o seu projeto."
        />
      )}
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
