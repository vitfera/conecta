---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedProjects, getPublishedProducts } from '../../lib/content';
export async function getStaticPaths() {
  return (await getPublishedProjects()).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);
const { recognition, externalLinks } = project.data;
const showMapasServices =
  (project.body ?? '').includes('Mapas Culturais') &&
  (await getPublishedProducts()).some(({ id }) => id === 'mapas-culturais');
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <section class="project-story-heading">
    <div class="container">
      <a class="text-link project-back" href="/projetos/">
        <Icon size={17} /> Todas as histórias
      </a>
      <div class="project-hero-grid">
        <div>
          <p class="eyebrow">
            <span class="orange-dash"></span>
            {project.data.title}
          </p>
          <h1>{project.data.storyTitle ?? project.data.title}</h1>
          <p class="project-story-intro">{project.data.description}</p>
        </div>
        <figure class="project-hero-media">
          <ProjectCover
            id={project.id}
            alt={`Tela inicial do ${project.data.title}.`}
            loading="eager"
            caption="Um olhar sobre a plataforma em funcionamento."
          />
        </figure>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container project-story-body">
      <article class="prose">
        <Content />
      </article>
      {recognition && (
        <aside
          class="project-recognition"
          aria-labelledby="recognition-title"
          data-project-recognition
        >
          <span class="icon-box">
            <Icon name="recognition" size={30} />
          </span>
          <div>
            <p class="eyebrow">{recognition.recipient}</p>
            <h2 id="recognition-title">{recognition.title}</h2>
            <p>{recognition.description}</p>
            <a
              class="text-link"
              href={recognition.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Sobre o reconhecimento <Icon name="diagonal" size={17} />
            </a>
          </div>
        </aside>
      )}
      <div class="project-story-next">
        {externalLinks.map((link) => (
          <a class="button" href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label} <Icon name="diagonal" size={18} />
          </a>
        ))}
        {showMapasServices && (
          <a class="text-link" href="/produtos/mapas-culturais/">
            Conheça nossos serviços com Mapas Culturais <Icon size={18} />
          </a>
        )}
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
