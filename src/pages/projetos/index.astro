---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import EmptyState from '../../components/EmptyState.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectStoryCard from '../../components/ProjectStoryCard.astro';
import { getPublishedProjects } from '../../lib/content';
const projects = await getPublishedProjects();
---

<BaseLayout
  title="Projetos"
  description="Conheça histórias de projetos em tecnologia, cultura, gestão e comunicação, com o contexto de cada trabalho e a participação da Conecta e de sua equipe."
  noindex={projects.length === 0}
>
  <PageHeading
    eyebrow="PROJETOS"
    title="Cada projeto, uma conexão com a realidade."
    description="Por trás de cada projeto, existem pessoas, necessidades e um contexto. Conheça algumas dessas histórias e a participação da Conecta em cada uma delas."
  />
  <section class="section">
    <div class="container">
      {projects.length ? (
        <div class="project-story-list">
          {projects.map((project) => (
            <ProjectStoryCard project={project} />
          ))}
        </div>
      ) : (
        <EmptyState
          icon="process"
          title="Novas histórias estão a caminho."
          description="Estamos preparando as histórias dos nossos projetos. Enquanto isso, converse com a equipe para conhecer nossa forma de trabalhar."
        />
      )}
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
