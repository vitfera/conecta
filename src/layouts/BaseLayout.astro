---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import logo from '../assets/conecta-logo.png';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/hero.css';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  breadcrumb?: { section: string; href: string; current: string };
}
const { title, description = site.description, noindex = false, breadcrumb } = Astro.props;
const pageTitle = `${title} | ${site.name}`;
const siteUrl = Astro.site;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl) : undefined;
const indexable = Boolean(siteUrl) && !noindex;
const image = await getImage({ src: logo, width: 1200, format: 'png' });
const imageUrl = siteUrl ? new URL(image.src, siteUrl).href : undefined;
const structuredData: Record<string, unknown>[] = [];
if (Astro.url.pathname === '/') {
  const organizationId = siteUrl && new URL('#organization', siteUrl).href;
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: site.name,
    legalName: site.legalName,
    taxID: site.cnpj,
    telephone: site.phoneNumber,
    url: siteUrl?.href,
    logo: imageUrl,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Aparecida de Goiânia',
      addressRegion: 'GO',
      addressCountry: 'BR',
    },
    areaServed: { '@type': 'Country', name: 'Brasil' },
  });
  if (indexable && canonical) {
    structuredData.push({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.name,
      url: canonical.href,
      inLanguage: 'pt-BR',
      publisher: { '@id': organizationId },
    });
  }
}
if (indexable && canonical && breadcrumb) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: breadcrumb.section,
        item: new URL(breadcrumb.href, canonical).href,
      },
      { '@type': 'ListItem', position: 2, name: breadcrumb.current, item: canonical.href },
    ],
  });
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#003675" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:alt" content="Conecta Soluções — Gestão, Cultura e Tecnologia" />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    {structuredData.map((entry) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(entry).replace(/</g, '\\u003c')}
      />
    ))}
  </head>
  <body>
    <div class="reading-progress" data-scroll-progress aria-hidden="true" hidden>
      <span></span>
    </div>
    <a href="#conteudo" class="skip-link">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
