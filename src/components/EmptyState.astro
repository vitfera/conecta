---
import Icon from './Icon.astro';
interface Props {
  icon: string;
  title: string;
  description: string;
}
const { icon, title, description } = Astro.props;
---

<div class="empty-state">
  <span class="icon-box">
    <Icon name={icon} size={29} />
  </span>
  <h2>{title}</h2>
  <p>{description}</p>
  <a class="text-link" href="/contato/">
    Converse com a Conecta <Icon size={18} />
  </a>
</div>
