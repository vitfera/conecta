---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  title: string;
  sizes?: string;
  detail?: boolean;
}
const {
  id,
  title,
  sizes = '(max-width: 640px) calc(100vw - 40px), (max-width: 900px) calc(100vw - 80px), 600px',
  detail = false,
} = Astro.props;
const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/projetos/*.png', {
  eager: true,
});
const cover = covers[`../assets/projetos/${id}.png`]?.default;
const Wrapper = detail ? 'figure' : 'div';
---

{cover && (
  <Wrapper class={detail ? 'project-hero-media' : 'project-story-media'}>
    <div class="project-cover" data-project-cover="image">
      <Image
        src={cover}
        alt={detail ? `Captura de tela da página pública relacionada a ${title}.` : ''}
        widths={[480, 800, 1200, 1440]}
        sizes={sizes}
        format="webp"
        loading={detail ? 'eager' : 'lazy'}
      />
    </div>
    {detail && <figcaption>Captura da página pública relacionada ao projeto.</figcaption>}
  </Wrapper>
)}
