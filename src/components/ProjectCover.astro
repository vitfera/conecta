---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  title: string;
  sizes?: string;
  detail?: boolean;
}
const {
  id,
  title,
  sizes = '(max-width: 640px) calc(100vw - 40px), (max-width: 900px) calc(100vw - 80px), 600px',
  detail = false,
} = Astro.props;
const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/projetos/*.png', {
  eager: true,
});
const artwork = covers[`../assets/projetos/${id}.artwork.png`]?.default;
const cover = artwork ?? covers[`../assets/projetos/${id}.png`]?.default;
const Wrapper = detail ? 'figure' : 'div';
const caption = artwork
  ? 'Arte de divulgação do projeto.'
  : 'Captura da página pública relacionada ao projeto.';
const alt = artwork
  ? `Arte de divulgação do projeto ${title}.`
  : `Captura de tela da página pública relacionada a ${title}.`;
---

{cover && (
  <Wrapper class={detail ? 'project-hero-media' : 'project-story-media'}>
    <div
      class="project-cover"
      data-project-cover={artwork ? 'artwork' : 'image'}
      data-project-id={id}
    >
      <Image
        src={cover}
        alt={detail ? alt : ''}
        widths={[480, 800, 1200, 1440].filter((width) => width < cover.width).concat(cover.width)}
        sizes={sizes}
        format="webp"
        loading={detail ? 'eager' : 'lazy'}
      />
    </div>
    {detail && <figcaption>{caption}</figcaption>}
  </Wrapper>
)}
