---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
interface Props {
  id: string;
  alt: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  caption?: string;
}
const {
  id,
  alt,
  sizes = '(max-width: 640px) calc(100vw - 40px), (max-width: 900px) calc(100vw - 80px), 600px',
  loading = 'lazy',
  caption,
} = Astro.props;
const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/projetos/*.png', {
  eager: true,
});
const screenshot = covers[`../assets/projetos/${id}.png`]?.default;
const illustration = covers[`../assets/projetos/${id}.illustration.png`]?.default;
const cover = screenshot ?? illustration;
const coverKind = screenshot ? 'image' : illustration ? 'illustration' : 'placeholder';
---

<div class="project-cover" data-project-cover={coverKind}>
  {cover ? (
    <Image
      src={cover}
      alt={coverKind === 'illustration' ? '' : alt}
      widths={[480, 800, 1200, 1440]}
      sizes={sizes}
      format="webp"
      loading={loading}
    />
  ) : (
    <div class="project-cover-placeholder" aria-hidden="true">
      <Icon name="culture" size={54} />
      <span>Gestão, cultura e tecnologia.</span>
    </div>
  )}
</div>

{cover && caption && (
  <figcaption>
    {coverKind === 'illustration' ? 'Ilustração conceitual sobre o contexto do projeto.' : caption}
  </figcaption>
)}
