---
import { analyticsOrigin, googleAnalyticsId } from '../lib/analytics';

const initialization = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${googleAnalyticsId}');
`;
---

{googleAnalyticsId && (
  <>
    <script is:inline define:vars={{ analyticsOrigin, googleAnalyticsId }}>
      if (window.location.origin !== analyticsOrigin) {
        window[`ga-disable-${googleAnalyticsId}`] = true;
      }
      window.dataLayer = window.dataLayer || [];
      function setGoogleTagDefaults() {
        window.dataLayer.push(arguments);
      }
      setGoogleTagDefaults('set', {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
    </script>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
    ></script>
    <script is:inline set:html={initialization}></script>
  </>
)}
