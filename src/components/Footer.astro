---
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { site, navigation } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <Logo />
      <p>
        Ideias, pessoas e tecnologia.
        <br />
        Conexões que fazem projetos acontecer.
      </p>
    </div>
    <div>
      <h2>Explore</h2>
      <nav aria-label="Navegação do rodapé">
        {navigation
          .filter(({ href }) => href !== '/')
          .map(({ href, label }) => (
            <a href={href}>{label}</a>
          ))}
      </nav>
    </div>
    <div class="footer-contact">
      <h2>Vamos conversar</h2>
      <WhatsAppButton label="WhatsApp" class="button-small footer-whatsapp" />
      <p class="footer-phone">{site.phone}</p>
      <p>
        {site.location}
        <br />
        Atendimento em todo o Brasil.
      </p>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>
      © {new Date().getFullYear()} Conecta Soluções. <span>CNPJ {site.cnpj}</span>
    </p>
    <a href="/politica-de-privacidade/">Política de privacidade</a>
  </div>
</footer>
