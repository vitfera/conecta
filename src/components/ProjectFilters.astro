---
interface Props {
  sectors: string[];
  natures: string[];
  relationships: string[];
}
const { sectors, natures, relationships } = Astro.props;
---

<form class="catalog-filters" data-project-filters hidden>
  <label>
    Setor
    <select name="sector">
      <option value="">Todos os setores</option>
      {sectors.map((value) => (
        <option value={value}>{value}</option>
      ))}
    </select>
  </label>
  <label>
    Natureza
    <select name="nature">
      <option value="">Todas as atuações</option>
      {natures.map((value) => (
        <option value={value}>{value}</option>
      ))}
    </select>
  </label>
  <label>
    Vínculo
    <select name="relationship">
      <option value="">Todos os vínculos</option>
      {relationships.map((value) => (
        <option value={value}>{value}</option>
      ))}
    </select>
  </label>
  <button class="text-link filter-reset" type="reset">
    Limpar filtros
  </button>
</form>
<p class="filter-results" data-project-count aria-live="polite" aria-atomic="true"></p>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-project-filters]');
  if (form) {
    form.hidden = false;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-project]')];
    const count = document.querySelector<HTMLElement>('[data-project-count]');
    function update() {
      if (!form) return;
      const filters = new FormData(form);
      let visible = 0;
      for (const card of cards) {
        card.hidden = ['sector', 'nature', 'relationship'].some((key) => {
          const value = filters.get(key);
          return value && card.dataset[key] !== value;
        });
        if (!card.hidden) visible++;
      }
      if (count)
        count.textContent = visible
          ? `${visible} ${visible === 1 ? 'projeto encontrado' : 'projetos encontrados'}.`
          : 'Nenhum projeto corresponde aos filtros. Experimente outra combinação.';
    }
    form.addEventListener('change', update);
    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('reset', () => requestAnimationFrame(update));
    update();
  }
</script>
